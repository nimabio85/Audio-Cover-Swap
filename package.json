{
  "name": "file-cover-replacer",
  "version": "1.5.0",
  "description": "A safe Windows desktop app for replacing audio cover art, editing tags, and converting media to audio.",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check electron-main.js && node --check preload.js && node --check public/app.js",
    "dist": "npm run check && electron-builder --win nsis portable --publish never",
    "pack": "electron-builder --dir"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.2.0",
    "music-metadata": "^11.14.0",
    "node-id3": "^0.2.9",
    "semver": "^7.8.5",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.coverswap.desktop",
    "productName": "CoverSwap",
    "publish": [
      {
        "provider": "github",
        "owner": "nimabio85",
        "repo": "Audio-Cover-Swap",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "CoverSwap-Setup-${version}-${arch}.${ext}",
      "differentialPackage": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "CoverSwap-Portable-${version}-${arch}.${ext}"
    }
  }
}
